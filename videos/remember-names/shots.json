{
  "title": "The rundown on remembering names",
  "music_mood": "upbeat",
  "hook_variants": [
    "You forget names the second you hear them.",
    "Why do you forget a name in five seconds?",
    "Stop forgetting names. Here's the trick."
  ],
  "shots": [
    {"id": 1, "text": "You forget names the second you hear them.", "role": "hook",
     "image": {"query": "awkward handshake meeting", "icon": "handshake", "cutout": false},
     "character": {"position": "centre", "action": "point"}, "transition": "cut", "camera": "zoom-in", "sfx": "whoosh"},
    {"id": 2, "text": "Most people think they're just bad with names.", "role": "myth",
     "image": {"query": "confused person thinking", "icon": "thinking-face", "cutout": false},
     "character": {"position": "right", "action": "shrug"}, "transition": "slide-left", "camera": "pan-left"},
    {"id": 3, "text": "But the truth is, the name never made it into your memory in the first place.", "role": "myth",
     "image": {"query": "brain illustration", "icon": "brain", "cutout": false},
     "character": {"position": "left", "action": "point"}, "transition": "slide-right", "camera": "zoom-in"},
    {"id": 4, "text": "Step one. Say it back right away.", "role": "step",
     "image": {"query": "people talking", "icon": "speaking-head", "cutout": false},
     "character": {"position": "centre", "action": "bounce"}, "transition": "slide-left", "camera": "zoom-out", "sfx": "pop"},
    {"id": 5, "text": "\"Nice to meet you, Sam.\" That one repeat makes you actually listen.", "role": "step",
     "image": {"query": "friendly handshake", "icon": "handshake", "cutout": false},
     "character": {"position": "right", "action": "wave"}, "transition": "slide-right", "camera": "pan-right"},
    {"id": 6, "text": "Step two. Picture it.", "role": "step",
     "image": {"query": "imagination idea", "icon": "light-bulb", "cutout": false},
     "character": {"position": "centre", "action": "bounce"}, "transition": "slide-left", "camera": "zoom-in", "sfx": "pop"},
    {"id": 7, "text": "Link the name to something you can see, like Sam holding a sandwich.", "role": "step",
     "image": {"query": "man holding sandwich", "icon": "sandwich", "cutout": false},
     "character": {"position": "left", "action": "point"}, "transition": "zoom", "camera": "zoom-out"},
    {"id": 8, "text": "Step three. Use it twice in the first minute.", "role": "step",
     "image": {"query": "conversation two people", "icon": "speech-balloon", "cutout": false},
     "character": {"position": "right", "action": "bounce"}, "transition": "slide-left", "camera": "zoom-in", "sfx": "pop"},
    {"id": 9, "text": "Then say it once more when you leave.", "role": "step",
     "image": {"query": "waving goodbye", "icon": "waving-hand", "cutout": false},
     "character": {"position": "centre", "action": "wave"}, "transition": "slide-right", "camera": "pan-left"},
    {"id": 10, "text": "Do all three, and you'll blank on names a lot less.", "role": "payoff",
     "image": {"query": "checklist done", "icon": "check-mark-button", "cutout": false},
     "character": {"position": "left", "action": "bounce"}, "transition": "whip", "camera": "zoom-in", "sfx": "ding"},
    {"id": 11, "text": "Because now it's stored, not just heard.", "role": "payoff",
     "image": {"query": "memory storage", "icon": "brain", "cutout": false},
     "character": {"position": "right", "action": "point"}, "transition": "slide-left", "camera": "static"},
    {"id": 12, "text": "That's the rundown. Next time someone says their name, catch it.", "role": "outro",
     "image": {"query": "handshake introduction", "icon": "handshake", "cutout": false},
     "character": {"position": "centre", "action": "wave"}, "transition": "slide-right", "camera": "zoom-out", "sfx": "whoosh"}
  ]
}
